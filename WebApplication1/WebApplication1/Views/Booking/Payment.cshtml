@model WebApplication1.Models.Room

<link href="~/Content/bootstrap.min.css" rel="stylesheet" />
<link href="~/Content/payment.css" rel="stylesheet" />

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.HideNavbar = true;

    var checkin = TempData["BookingCheckIn"] as DateTime? ?? DateTime.Today;
    var checkout = TempData["BookingCheckOut"] as DateTime? ?? DateTime.Today.AddDays(1);
    var totalPrice = TempData["BookingTotal"] as int? ?? 0;
    TempData.Keep();
}

<div class="Payment-container">
    <header class="booking-header">
        <div class="logo">HMS</div>
    </header>

    <div class="steps">
        <div class="step done">✔</div>
        <div class="step done">✔</div>
        <div class="step">3</div>
    </div>

    <h4 class="payment-title">Payment</h4>
    <p class="payment-subtitle">Please fill in your guest information and select a payment method</p>

    @* Hiển thị lỗi nếu có *@
    @if (TempData["BookingError"] != null)
    {
        <div class="alert alert-danger mt-3">
            @TempData["BookingError"]
        </div>
    }

    @using (Html.BeginForm("ProcessPayment", "Payment", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.Hidden("roomId", Model.RoomId)
        @Html.Hidden("checkin", checkin.ToString("yyyy-MM-dd"))
        @Html.Hidden("checkout", checkout.ToString("yyyy-MM-dd"))
        @Html.Hidden("totalPrice", totalPrice)

        <div class="row g-4">
            <!-- Room Summary -->
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <img src="@(!string.IsNullOrEmpty(Model.Image) ? Model.Image : Url.Content("~/Images/no-image.png"))"
                         alt="Room @Model.RoomNumber"
                         class="card-img-top rounded-top"
                         style="object-fit: cover; height: 180px;" />
                    <div class="card-body">
                        <h5 class="card-title">Room Summary</h5>
                        <p><strong>Room:</strong> Room @Model.RoomNumber (@(Model.RoomType?.Name))</p>
                        <p><strong>Stay:</strong> @checkin.ToString("dd/MM/yyyy") → @checkout.ToString("dd/MM/yyyy")</p>
                        <p><strong>Total Price:</strong> <span class="text-success fw-bold">$@totalPrice</span></p>
                    </div>
                </div>
            </div>

            <!-- Guest Info -->
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Guest Information</h5>
                        <input name="GuestFirstName" class="form-control mb-2" placeholder="First Name" required />
                        <input name="GuestLastName" class="form-control mb-2" placeholder="Last Name" required />
                        <input name="GuestEmailAddress" type="email" class="form-control mb-2" placeholder="Email Address" required />
                        <input name="GuestContactNumber" class="form-control mb-2" placeholder="Phone Number" required />
                        <input name="Street" class="form-control mb-2" placeholder="Street Address" required />
                        <input name="City" class="form-control mb-2" placeholder="City" required />
                        <input name="Zip" class="form-control mb-2" placeholder="ZIP Code" required />
                    </div>
                </div>
            </div>

            <!-- Payment Info -->
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">Payment Method</h5>
                        <select name="PaymentType" class="form-control mb-3" required>
                            <option value="" disabled selected>-- Select Payment Method --</option>
                            <option value="CreditCard">Credit Card</option>
                            <option value="Momo">Momo</option>
                            <option value="VNPay">VNPay</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- Submit Button -->
        <div class="text-end mt-4">
            <button type="submit" class="btn btn-success px-4">Confirm & Pay</button>
        </div>
    }

</div>


@section Scripts {
    <script>
        // Xác nhận trước khi thanh toán
        document.querySelector("form").addEventListener("submit", function (e) {
            if (!confirm("Bạn có chắc muốn thanh toán và đặt phòng không?")) {
                e.preventDefault();
            }
        });
    </script>
}
