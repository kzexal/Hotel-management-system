@model List<WebApplication1.Models.RoomBooked>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.HideNavbar = true;
}

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/Content/UserDashboard.css" />

<div class="dashboard-container">
    <!-- Sidebar -->
    <div class="sidebar">
        <h1>HMS</h1>
        <nav>
            <a class="active" href="#">📘 Bookings</a>
            <a href="#">✉️ Message</a>
            <a href="#">❓ Help</a>
            <a href="#">⚙️ Setting</a>
        </nav>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Bar -->
        <div class="top-bar">
            <div><p class="mb-0 fw-semibold">Hello, @Session["Username"]</p></div>
            <div class="user-info">
                <img src="https://tse4.mm.bing.net/th/id/OIP.9_MptOLxjJEGSGukPt9FWQHaHa" alt="User" />
                <div>
                    <p class="mb-0">@Session["Username"]</p>
                    <small>@(((int)Session["Role"] == 1) ? "Admin" : "User")</small>
                </div>
            </div>
        </div>


        <!-- Success/Fail message -->
        @if (TempData["ServiceSuccess"] != null)
        {
            <div class="alert alert-success">@TempData["ServiceSuccess"]</div>
        }
        else if (TempData["ServiceError"] != null)
        {
            <div class="alert alert-danger">@TempData["ServiceError"]</div>
        }

        <!-- Booking Cards -->
        <div id="booking-section" class="card-container">
            @foreach (var rb in Model)
            {
                <div class="card">
                    <div class="card-img">
                        <img src="@rb.Room.Image" alt="Room Image" />
                    </div>
                    <div class="card-body">
                        <h3>Room @rb.Room.RoomNumber - @rb.Room.RoomType.Name</h3>
                        <p>Check-in: @rb.Booking.CheckInDate.ToString("dd MMM yyyy")</p>
                        <p>Check-out: @rb.Booking.CheckOutDate.ToString("dd MMM yyyy")</p>
                        <p>Status: @rb.Booking.Status</p>
                        <div class="actions">
                            <button class="btn btn-primary" onclick="openServiceModal(@rb.Booking.BookingId)">Book Service</button>
                            <button class="btn btn-danger">Delete</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<<!-- Service Modal -->
<div class="modal fade" id="serviceModal" tabindex="-1" aria-labelledby="serviceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <!-- thêm modal-lg cho rộng hơn -->
        <div class="modal-content">
            <form method="post" action="/Payment/ProcessServicePayment">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Book a Service</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="bookingIdInput" name="bookingId" />

                    <div class="row">
                        <!-- Left: Service List -->
                        <div class="col-md-6 border-end">
                            <h6>Select Services</h6>
                            <div id="serviceCheckboxList" class="form-check"></div>
                        </div>

                        <!-- Right: Payment Info -->
                        <div class="col-md-6">
                            <h6>Payment Type</h6>
                            <div class="mb-3">
                                <select class="form-select" name="PaymentType" required>
                                    <option value="">-- Select --</option>
                                    <option value="Credit Card">Credit Card</option>
                                    <option value="Cash">Cash</option>
                                    <option value="Momo">Momo</option>
                                    <option value="VNPay">VNPay</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Pay and Book</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    function openServiceModal(bookingId) {
        document.getElementById("bookingIdInput").value = bookingId;
        fetch('/Service/GetServices')
            .then(res => res.json())
            .then(services => {
                const container = document.getElementById("serviceCheckboxList");
                container.innerHTML = '';
                services.forEach(s => {
                    const div = document.createElement("div");
                    div.className = "form-check";
                    div.innerHTML = `
                        <input class="form-check-input" type="checkbox" name="selectedServiceIds" value="${s.ServiceId}" id="s${s.ServiceId}">
                        <label class="form-check-label" for="s${s.ServiceId}">
                            ${s.ServiceName} - $${s.ServiceCost}
                        </label>
                    `;
                    container.appendChild(div);
                });

                const modalEl = document.getElementById('serviceModal');
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            });
    }
</script>
