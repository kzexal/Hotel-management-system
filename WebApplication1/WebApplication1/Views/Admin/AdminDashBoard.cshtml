                    updateSummaryCards(response.summary);
                } else {
                    console.error('Error in response:', response);
                }
            },
            error: function(xhr, status, error) {
                console.error('AJAX error:', error);
                alert('Error loading report data');
            }
        });
    }

    function updateSummaryCards(summary) {
        if (!summary) {
            console.error('No summary data provided');
            return;
        }

        console.log('Updating summary cards with:', summary);

        $('#totalRevenue').text('$' + (summary.totalRevenue || 0).toLocaleString());
        $('#avgMonthlyRevenue').text('$' + (summary.averageMonthlyRevenue || 0).toLocaleString());
        $('#bestMonth').text(summary.bestMonth || '-');
        $('#bestMonthRevenue').text('$' + (summary.bestMonthRevenue || 0).toLocaleString());
        $('#avgBookings').text(Math.round(summary.averageBookingsPerMonth || 0));

        const changeText = summary.percentageChange >= 0
            ? `+${(summary.percentageChange || 0).toFixed(1)}% vs previous period`
            : `${(summary.percentageChange || 0).toFixed(1)}% vs previous period`;
        $('#revenueChange').text(changeText);
    }

