        function searchBookings() {
            const bookingId = $('#searchBookingId').val().toLowerCase();
            const cccd = $('#searchCCCD').val().toLowerCase();
            const roomNumber = $('#searchRoomNumber').val().toLowerCase();
            const fromDate = $('#searchFromDate').val();
            const toDate = $('#searchToDate').val();

            // Hide all rows initially
            const rows = $('#bookings-tab-pane tbody tr');
            rows.hide();

            // Filter rows based on search criteria
            rows.each(function () {
                const row = $(this);
                const rowBookingId = row.find('td:first').text().toLowerCase();
                const rowGuestInfo = row.find('td:nth-child(2)').text().toLowerCase();
                const rowRoomNumber = row.find('td:nth-child(3)').text().toLowerCase();
                const rowCheckIn = new Date(row.find('td:nth-child(4)').text());
                const rowCheckOut = new Date(row.find('td:nth-child(5)').text());

                let matches = true;

                // Check each filter condition
                if (bookingId && !rowBookingId.includes(bookingId)) matches = false;
                if (cccd) {
                    const rowCCCD = row.find('td:nth-child(2) small:contains("CCCD:")').text().toLowerCase().replace('cccd:', '').trim();
                    if (!rowCCCD.includes(cccd)) matches = false;
                }
                if (roomNumber && !rowRoomNumber.includes(roomNumber)) matches = false;

                // Date range check
                if (fromDate) {
                    const fromDateObj = new Date(fromDate);
                    if (rowCheckIn < fromDateObj) matches = false;
                }
                if (toDate) {
                    const toDateObj = new Date(toDate);
                    if (rowCheckOut > toDateObj) matches = false;
                }

                // Show row if all conditions match
                if (matches) {
                    row.show();
                }
            });

            // Show message if no results found
            const visibleRows = rows.filter(':visible').length;
            if (visibleRows === 0) {
                if (!$('#no-results-message').length) {
                    $('#bookings-tab-pane tbody').append(
                        '<tr id="no-results-message"><td colspan="8" class="text-center py-3">' +
                        '<i class="bi bi-info-circle me-2"></i>No bookings found matching your search criteria</td></tr>'
                    );
                }
            } else {
                $('#no-results-message').remove();
            }
        }

        function resetSearch() {
            // Clear all search inputs
            $('#searchBookingId').val('');
            $('#searchCCCD').val('');
            $('#searchRoomNumber').val('');
            $('#searchFromDate').val('');
            $('#searchToDate').val('');

            // Show all rows
            $('#bookings-tab-pane tbody tr').show();
            $('#no-results-message').remove();
        }

        // Add event listeners for real-time search
        $(document).ready(function () {
            const searchInputs = '#searchBookingId, #searchGuestName, #searchRoomNumber, #searchStatus, #searchFromDate, #searchToDate';
            $(searchInputs).on('input change', function () {
                searchBookings();
            });
        });

  
    </script>
