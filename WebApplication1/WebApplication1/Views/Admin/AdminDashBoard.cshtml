    <script>
    $(document).ready(function () {
        // Initialize variables
        let selectedDates = [];
        let currentRoomPrice = 0;
        let selectedRoomId = null;
        let unavailableDates = [];
        let checkInPicker = null;
        let checkOutPicker = null;

        function initializeFlatpickr() {
            try {
                // Destroy existing instances if any
                if (checkInPicker && typeof checkInPicker.destroy === 'function') {
                    checkInPicker.destroy();
                }
                if (checkOutPicker && typeof checkOutPicker.destroy === 'function') {
                    checkOutPicker.destroy();
                }

                checkInPicker = null;
                checkOutPicker = null;

                const commonConfig = {
                    dateFormat: "Y-m-d",
                    disable: unavailableDates,
                    minDate: "today",
                    allowInput: false,
                    disableMobile: true,
                    enableTime: false
                };

                // Initialize check-in date picker
                checkInPicker = flatpickr("#checkInDate", {
                    ...commonConfig,
                    onChange: function(selectedDates, dateStr) {
                        console.log('Check-in date changed:', dateStr);
                        
                        if (selectedDates[0]) {
                            const nextDay = new Date(selectedDates[0]);
                            nextDay.setDate(nextDay.getDate() + 1);
                            
                            if (checkOutPicker && typeof checkOutPicker.clear === 'function') {
                                checkOutPicker.clear();
                                checkOutPicker.set('minDate', nextDay);
                                console.log('Updated check-out min date:', nextDay);
                            }
                        }
                        calculateTotalCost();
                    }
                });

                // Initialize check-out date picker
                checkOutPicker = flatpickr("#checkOutDate", {
                    ...commonConfig,
                    onChange: function(selectedDates, dateStr) {
                        console.log('Check-out date changed:', dateStr);
                        if (selectedDates[0]) {
                            calculateTotalCost();
                        }
                    }
                });

                // Reset dates
                if (checkInPicker && typeof checkInPicker.clear === 'function') {
                    checkInPicker.clear();
                }
                if (checkOutPicker && typeof checkOutPicker.clear === 'function') {
                    checkOutPicker.clear();
                }

                console.log('Flatpickr initialized successfully');
            } catch (error) {
                console.error('Error initializing Flatpickr:', error);
            }
        }

        // Initialize on page load
        initializeFlatpickr();

        // Reset form and reinitialize Flatpickr when modal is shown
        $('#createBookingModal').on('shown.bs.modal', function() {
            selectedDates = [];
            currentRoomPrice = 0;
            selectedRoomId = null;
            unavailableDates = [];
            $('#roomSelect').val('');
            
            // Reset the date inputs
            $('#checkInDate').val('');
            $('#checkOutDate').val('');
            
            initializeFlatpickr();
            calculateTotalCost();
        });

        // Room selection handler
        $('#roomSelect').change(function() {
            selectedRoomId = $(this).val();
            currentRoomPrice = parseFloat($(this).find('option:selected').data('price')) || 0;
            console.log('Selected room:', {
                roomId: selectedRoomId,
                price: currentRoomPrice
            });

            if (!selectedRoomId) {
                if (checkInPicker && typeof checkInPicker.clear === 'function') {
                    checkInPicker.clear();
                }
                if (checkOutPicker && typeof checkOutPicker.clear === 'function') {
                    checkOutPicker.clear();
                }
                selectedDates = [];
                calculateTotalCost();
                return;
            }

            // Get unavailable dates
            $.ajax({
                url: '@Url.Action("GetUnavailableDates", "Admin")',
                type: 'GET',
                data: { roomId: selectedRoomId },
                success: function(response) {
                    console.log('Unavailable dates response:', response);
                    if (response.success && response.dates) {
                        unavailableDates = response.dates.map(date => new Date(date));
                        initializeFlatpickr();
                        console.log('Reinitialized date pickers with new unavailable dates');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error getting unavailable dates:', error);
                }
            });
        });

        function calculateTotalCost() {
            try {
                let roomCost = 0;
                let servicesCost = 0;

                // Calculate room cost
                if (checkInPicker && checkOutPicker && 
                    typeof checkInPicker.selectedDates !== 'undefined' && 
                    typeof checkOutPicker.selectedDates !== 'undefined') {
                    
                    const checkinDate = checkInPicker.selectedDates[0];
                    const checkoutDate = checkOutPicker.selectedDates[0];
                    
                    console.log('Calculating cost for dates:', { 
                        checkinDate: checkinDate ? checkinDate.toISOString() : null, 
                        checkoutDate: checkoutDate ? checkoutDate.toISOString() : null,
                        currentRoomPrice 
                    });
                    
                    if (checkinDate && checkoutDate && checkoutDate > checkinDate) {
                        const days = Math.ceil((checkoutDate - checkinDate) / (1000 * 60 * 60 * 24));
                        roomCost = currentRoomPrice * days;
                        console.log('Calculated room cost:', { days, roomCost });
                    }
                }

                // Calculate services cost
                $('.service-checkbox:checked').each(function() {
                    const cost = parseFloat($(this).data('cost'));
                    if (!isNaN(cost)) {
                        servicesCost += cost;
                    }
                });

                // Update display
                $('#roomCost').text(`$${roomCost.toFixed(2)}`);
                $('#servicesCost').text(`$${servicesCost.toFixed(2)}`);
                $('#totalCost').text(`$${(roomCost + servicesCost).toFixed(2)}`);

            } catch (error) {
                console.error('Error calculating cost:', error);
                $('#roomCost').text('$0.00');
                $('#servicesCost').text('$0.00');
                $('#totalCost').text('$0.00');
            }
        }

        // Service checkbox handler
        $('.service-checkbox').change(calculateTotalCost);

        // Form submission
        $('#createBookingForm').on('submit', function(e) {
            e.preventDefault();

            if (!selectedRoomId || !checkInPicker || !checkOutPicker) {
                alert('Please complete all booking information');
                return;
            }

            const checkinDate = checkInPicker.selectedDates && checkInPicker.selectedDates[0];
            const checkoutDate = checkOutPicker.selectedDates && checkOutPicker.selectedDates[0];

            if (!checkinDate || !checkoutDate) {
                alert('Please select both check-in and check-out dates');
                return;
            }

            const formData = {
                GuestFirstName: $('#guestFirstName').val(),
                GuestLastName: $('#guestLastName').val(),
                GuestEmailAddress: $('#guestEmail').val(),
                GuestContactNumber: $('#guestPhone').val(),
                Street: $('#guestStreet').val(),
                City: $('#guestCity').val(),
                Zip: $('#guestZip').val(),
                RoomId: selectedRoomId,
                CheckInDate: checkinDate.toISOString().split('T')[0],
                CheckOutDate: checkoutDate.toISOString().split('T')[0],
                Services: $('.service-checkbox:checked').map(function() {
                    return $(this).val();
                }).get(),
                TotalAmount: parseFloat($('#totalCost').text().replace('$', ''))
            };

            $.ajax({
                url: '@Url.Action("CreateBooking", "Admin")',
                type: 'POST',
                data: formData,
                success: function(response) {
                    if (response.success) {
                        alert('Booking created successfully!');
                        $('#createBookingModal').modal('hide');
                        location.reload();
                    } else {
                        alert(response.message || 'Failed to create booking');
                    }
                },
                error: function() {
                    alert('Error occurred while creating booking');
                }
            });
        });

        // Reset form when modal is hidden
        $('#createBookingModal').on('hidden.bs.modal', function() {
            $('#createBookingForm')[0].reset();
            selectedDates = [];
            selectedRoomId = null;
            currentRoomPrice = 0;
            
            if (checkInPicker && typeof checkInPicker.clear === 'function') {
                checkInPicker.clear();
            }
            if (checkOutPicker && typeof checkOutPicker.clear === 'function') {
                checkOutPicker.clear();
            }
            
            calculateTotalCost();
        });
    });

    function showBookingDetails(bookingId) {
        if (!bookingId || isNaN(bookingId)) {
            alert("Invalid booking ID.");
            return;
        }

        $('#bookingDetailsModal').modal('show');
        $('#guestName, #guestEmail, #guestPhone, #roomNumber, #roomType, #roomPrice, #bookingId, #bookingDate, #checkInDate, #checkOutDate, #totalDays, #totalAmount, #bookingStatus').text('Loading...');
        $('#serviceInfoList').html('<li>Loading services...</li>');

        $.ajax({
            url: '@Url.Action("GetBookingDetails", "Admin")',
            type: 'GET',
            data: { id: bookingId },
            success: function (response) {
                if (!response || response.success === false) {
                    alert(response?.message || "Booking not found.");
                    $('#bookingDetailsModal').modal('hide');
                    return;
                }

                try {
                    const guest = response.guest || {};
                    $('#guestName').text(`${guest.GuestFirstName || ''} ${guest.GuestLastName || ''}`.trim() || 'N/A');
                    $('#guestCCCD').text(guest.CCCD || 'N/A');
                    $('#guestEmail').text(guest.GuestEmailAddress || 'N/A');
                    $('#guestPhone').text(guest.GuestContactNumber || 'N/A');

                    const room = response.room || {};
                    $('#roomNumber').text(room.RoomNumber ? `Room ${room.RoomNumber}` : 'N/A');
                    $('#roomType').text(room.RoomType?.Name || 'N/A');
                    $('#roomPrice').text(room.RoomType?.Cost ? `$${room.RoomType.Cost}` : 'N/A');

                    const booking = response.booking || {};
                    $('#bookingId').text(booking.BookingId ? `#${booking.BookingId}` : 'N/A');

                    const bookingDate = booking.BookingDate ? new Date(booking.BookingDate) : null;
                    const checkIn = booking.CheckInDate ? new Date(booking.CheckInDate) : null;
                    const checkOut = booking.CheckOutDate ? new Date(booking.CheckOutDate) : null;

                    const dateOptions = { year: 'numeric', month: '2-digit', day: '2-digit' };
                    $('#bookingDate').text(bookingDate ? bookingDate.toLocaleDateString('en-US', dateOptions) : 'N/A');
                    $('#checkInDate').text(checkIn ? checkIn.toLocaleDateString('en-US', dateOptions) : 'N/A');
                    $('#checkOutDate').text(checkOut ? checkOut.toLocaleDateString('en-US', dateOptions) : 'N/A');

                    if (checkIn && checkOut && checkIn < checkOut) {
                        const days = Math.ceil((checkOut - checkIn) / (1000 * 60 * 60 * 24));
                        $('#totalDays').text(`${days} ${days === 1 ? 'day' : 'days'}`);
                    } else {
                        $('#totalDays').text('N/A');
                    }

                    $('#totalAmount').text(booking.BookingAmount != null ? `$${booking.BookingAmount}` : 'N/A');

                    const status = booking.Status || 'Unknown';
                    const statusClass = status.toLowerCase() === 'checkin' ? 'primary' :
                                        status.toLowerCase() === 'checkout' ? 'success' : 'warning';
                    $('#bookingStatus').html(`<span class="badge bg-${statusClass}">${status}</span>`);

                    const canCancel = status.toLowerCase() === 'checkin';
                    $('#cancelBookingBtn')
                        .prop('disabled', !canCancel)
                        .toggleClass('btn-danger', canCancel)
                        .toggleClass('btn-secondary', !canCancel)
                        .data('booking-id', booking.BookingId);

                    // Service Info
                    const services = response.services || [];
                    const $serviceList = $('#serviceInfoList');
                    $serviceList.empty();

                    if (services.length > 0) {
                        services.forEach(service => {
                            const name = service.ServiceName || 'Unnamed Service';
                            const price = service.Price != null ? `$${service.Price}` : 'N/A';
                            $serviceList.append(`<li class="mb-2"><i class="bi bi-check2-circle text-warning"></i> <strong>${name}</strong>: <span class="ms-2">${price}</span></li>`);
                        });
                    } else {
                        $serviceList.append('<li><i class="bi bi-info-circle text-muted"></i> No additional services used.</li>');
                    }

                } catch (err) {
                    console.error("Error processing booking details:", err);
                    alert("Error processing booking details. Please try again.");
                }
            },
            error: function () {
                alert("Error loading booking details. Please try again.");
                $('#bookingDetailsModal').modal('hide');
            }
        });
    }

